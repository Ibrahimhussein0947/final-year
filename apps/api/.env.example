DATABASE_URL="postgresql://ethiotalent:change_me_locally@localhost:5433/ethiotalent?schema=public"
JWT_ACCESS_SECRET=replace_with_64_random_chars_minimum_32
PORT=4100
CORS_ORIGINS=http://localhost:5173
BCRYPT_ROUNDS=12
EXPOSE_DEV_OTP=false

# Optional Python AI service (semantic matching). Leave unset to use the rule-based score only.
# AI_SERVICE_URL=http://127.0.0.1:8100
# AI_SERVICE_TOKEN=same_value_as_in_apps_ai_dot_env_at_least_24_chars

# Optional SMS gateway (generic JSON API). Leave unset: SMS is then never sent and the app says so.
# Video interviews: a meeting service the platform builds private room links on (self-hosting Jitsi Meet is recommended).
# VIDEO_BASE_URL=https://meet.example.com
# SMS_GATEWAY_URL=https://sms.example.com/send
# SMS_GATEWAY_TOKEN=your_gateway_token
# SMS_SENDER_ID=EthioTalent

# Optional: Africa's Talking SMS (used instead of the generic gateway when both are set). AT_SANDBOX=true for test servers.
# AT_USERNAME=sandbox
# AT_API_KEY=your_africas_talking_api_key
# AT_SANDBOX=false
# Optional: email through Resend. EMAIL_FROM must be on a domain you verified at Resend.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=EthioTalent <no-reply@yourdomain.com>

# Optional: Telegram job alerts. Create a bot with @BotFather, then set these and run: npm run telegram:webhook -- https://your-public-site
# TELEGRAM_BOT_TOKEN=123456789:replace_with_the_token_from_botfather
# TELEGRAM_BOT_USERNAME=YourBotName_bot
# TELEGRAM_WEBHOOK_SECRET=make_up_16_to_256_letters_digits_underscore_dash
# PUBLIC_URL=https://jobs.example.com

# Optional: scan uploads with a ClamAV daemon (clamd). CLAMAV_REQUIRED=true refuses uploads whenever it cannot be reached.
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# CLAMAV_REQUIRED=false

# Optional: OCR languages for reading document photos (default eng). For Amharic add amh.traineddata to ocr-data/ and set eng+amh.
# OCR_LANGS=eng
