// EthioTalent AI - database schema (Phase 2)
// Embeddings are stored as Float[] for now; a pgvector column/index can be added
// with a raw SQL migration in Phase 9 if ANN search is needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  WORKER
  EMPLOYER
  ADMIN
  TRAINER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum Locale {
  en
  am
  om
}

enum LocationLevel {
  REGION
  ZONE
  WOREDA
  KEBELE
}

enum EvidenceSource {
  SELF_REPORTED
  VERIFIED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  TEMPORARY
  CONTRACT
  FREELANCE
  INTERNSHIP
  SEASONAL
  DAILY
  PERMANENT
  CASUAL
  APPRENTICESHIP
  VOLUNTEER
  GIG
  ON_CALL
}

// How the pay of a job is counted. Null means the employer did not say (older jobs): treated as monthly.
enum PayBasis {
  MONTHLY
  WEEKLY
  DAILY
  HOURLY
  PER_PROJECT
  COMMISSION
  PIECE_RATE
  PERFORMANCE
  NEGOTIABLE
  UNPAID
}

// Where the work is done. One of the independent dimensions of a job, next to its occupation and employment type.
enum Workplace {
  OFFICE
  HOME
  FACTORY
  FARM
  HEALTH_FACILITY
  CONSTRUCTION_SITE
  OUTDOOR
  INDUSTRIAL_FACILITY
  VEHICLE
  SHIP
  AIRCRAFT
  LABORATORY
  RETAIL_SHOP
  MULTIPLE_SITES
  FULLY_REMOTE
}

// How the employer selects people. Describes the process to applicants; it does not change what the platform enforces.
enum RecruitmentMethod {
  OPEN
  INTERNAL
  REFERRAL
  DIRECT
  COMPETITIVE
  MASS
  EMERGENCY
  SEASONAL
  CAMPUS
  AGENCY
}

// How senior a position is. Null means the employer did not say; matching does not use it.
enum JobSeniority {
  ENTRY
  JUNIOR
  INTERMEDIATE
  SENIOR
  SPECIALIST
  SUPERVISOR
  MANAGER
  EXECUTIVE
}

enum WorkMode {
  ON_SITE
  REMOTE
  HYBRID
}

enum AvailabilityStatus {
  IMMEDIATELY
  WITHIN_TWO_WEEKS
  WITHIN_ONE_MONTH
  FLEXIBLE
  NOT_AVAILABLE
}

enum EducationLevel {
  NONE
  PRIMARY
  SECONDARY
  VOCATIONAL_CERTIFICATE
  DIPLOMA
  BACHELOR
  MASTER
  DOCTORATE
}

enum OrganizationType {
  PRIVATE_COMPANY
  PUBLIC_ENTERPRISE
  GOVERNMENT
  NGO
  SME
  CONSTRUCTION
  FACTORY
  HOTEL_RESTAURANT
  AGRICULTURAL
  HOUSEHOLD
  INDIVIDUAL
  RECRUITMENT_AGENCY
  TRAINING_INSTITUTION
  COOPERATIVE
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum JobStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  CLOSED
  FILLED
  REMOVED
}

enum SkillImportance {
  REQUIRED
  PREFERRED
}

enum SkillRelationType {
  SIBLING
  PREREQUISITE
  TRANSFERABLE
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW_SCHEDULED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum InterviewMode {
  IN_PERSON
  PHONE
  VIDEO
}

enum InterviewResponse {
  PENDING
  CONFIRMED
  DECLINED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum RecommendationDirection {
  JOB_TO_WORKER
  WORKER_TO_JOB
}

enum FeedbackAction {
  VIEWED
  SHORTLISTED
  APPLIED
  HIRED
  DISMISSED
}

enum VerificationKind {
  IDENTITY
  PHONE
  EMAIL
  EMPLOYER
  QUALIFICATION
  SKILL
  PASSWORD_RESET
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportTargetType {
  JOB
  USER
  SERVICE
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum FileKind {
  PROFILE_PHOTO
  CV
  VERIFICATION_EVIDENCE
  CERTIFICATE
  PORTFOLIO
}

// ───────────────────────── Identity ─────────────────────────

model User {
  id                 String        @id @default(uuid())
  phone              String        @unique
  email              String?       @unique
  passwordHash       String
  fullName           String
  role               Role
  status             AccountStatus @default(ACTIVE)
  locale             Locale        @default(en)
  phoneVerifiedAt    DateTime?
  emailVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  mustChangePassword Boolean       @default(false) // set when someone else chose the password
  totpSecret         String? // authenticator-app secret (administrators)
  totpEnabledAt      DateTime? // null until the first code is confirmed
  totpLastStep       Int? // last accepted time step, so a code cannot be reused
  // Notification preferences (workers can opt out of job-match alerts; SMS is opt-in and needs a verified phone)
  notifyJobMatches   Boolean       @default(true)
  autoApply          Boolean       @default(false) // opt-in: apply by itself to jobs that match well
  autoApplyMinScore  Int           @default(80)
  notifySms          Boolean       @default(false)
  // Telegram alerts: linked by a one-time code the user sends to the bot, never by guessing from a phone number.
  telegramChatId        String?   @unique
  telegramLinkedAt      DateTime?
  notifyTelegram        Boolean   @default(false)
  telegramLinkHash      String?   @unique // sha256 of the pending link code; cleared once used
  telegramLinkExpiresAt DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  workerProfile     WorkerProfile?
  employerProfile   EmployerProfile?
  refreshTokens     RefreshToken[]
  otpCodes          OtpCode[]
  notifications     Notification[]
  sentMessages      Message[]                 @relation("MessageSender")
  conversations     ConversationParticipant[]
  verifications     VerificationRequest[]     @relation("VerificationRequester")
  reviewedVerifs    VerificationRequest[]     @relation("VerificationReviewer")
  reportsFiled      Report[]                  @relation("ReportReporter")
  reportsResolved   Report[]                  @relation("ReportResolver")
  auditLogs         AuditLog[]
  files             FileAsset[]
  documentChecks    DocumentCheck[]
  reviewsWritten    Review[]                  @relation("ReviewAuthor")
  reviewsReceived   Review[]                  @relation("ReviewSubject")
  jobsPosted        Job[]
  invitationsSent   JobInvitation[]           @relation("InvitationSender")
  serviceInquiries  ServiceInquiry[]          @relation("InquiryCustomer")
  serviceBlocksMade ServiceBlock[]            @relation("BlockProvider")
  serviceBlocksOn   ServiceBlock[]            @relation("BlockCustomer")
  savedSearches     SavedSearch[]

  @@index([role, status])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One-time codes for phone and email verification (stored hashed, short-lived).
model OtpCode {
  id         String           @id @default(uuid())
  userId     String
  kind       VerificationKind // PHONE or EMAIL
  codeHash   String
  expiresAt  DateTime
  attempts   Int              @default(0)
  consumedAt DateTime?
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

// ───────────────────────── Geography ─────────────────────────

model Location {
  trainingCourses TrainingCourse[]
  id              String           @id @default(uuid())
  level           LocationLevel
  nameEn          String
  nameAm          String?
  nameOm          String?
  parentId        String?
  lat             Float?
  lng             Float?
  parent          Location?        @relation("LocationTree", fields: [parentId], references: [id])
  children        Location[]       @relation("LocationTree")

  workers         WorkerProfile[]
  organizations   Organization[]
  jobs            Job[]
  serviceListings ServiceListing[]

  @@unique([parentId, nameEn])
  @@index([level])
  @@index([parentId])
}

// ───────────────────────── Taxonomy ─────────────────────────

model Category {
  id       String     @id @default(uuid())
  slug     String     @unique
  nameEn   String
  nameAm   String?
  nameOm   String?
  isActive Boolean    @default(true)
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  skills               Skill[]
  jobs                 Job[]
  serviceListings      ServiceListing[]
  workers              WorkerProfile[]
  experiences          WorkExperience[]
  matchWeights         MatchWeights[]
  criterionDefinitions CriterionDefinition[]

  @@index([parentId])
}

model Skill {
  skillTests      SkillTest[]
  portfolioItems  PortfolioItem[]
  trainingCourses TrainingCourseSkill[]
  id              String                @id @default(uuid())
  slug            String                @unique
  categoryId      String
  nameEn          String
  nameAm          String?
  nameOm          String?
  aliases         String[]
  embedding       Float[]
  isActive        Boolean               @default(true)
  category        Category              @relation(fields: [categoryId], references: [id])

  workerSkills  WorkerSkill[]
  jobSkills     JobSkill[]
  relationsA    SkillRelation[] @relation("SkillA")
  relationsB    SkillRelation[] @relation("SkillB")
  serviceSkills ServiceSkill[]

  @@index([categoryId])
}

model SkillRelation {
  skillAId String
  skillBId String
  type     SkillRelationType
  weight   Float             @default(0.5) // credit in [0,1] when B stands in for A
  skillA   Skill             @relation("SkillA", fields: [skillAId], references: [id], onDelete: Cascade)
  skillB   Skill             @relation("SkillB", fields: [skillBId], references: [id], onDelete: Cascade)

  @@id([skillAId, skillBId])
  @@index([skillBId])
}

// ───────────────────────── Worker side ─────────────────────────

model WorkerProfile {
  skillAttempts      SkillTestAttempt[]
  portfolio          PortfolioItem[]
  employerReviews    EmployerReview[]
  offers             JobOffer[]
  id                 String             @id @default(uuid())
  userId             String             @unique
  headline           String?
  bio                String?
  occupation         String?
  categoryId         String?
  yearsExperience    Int                @default(0)
  expectedSalaryMin  Int?
  expectedSalaryMax  Int?
  preferredTypes     EmploymentType[]
  preferredWorkModes WorkMode[]
  availability       AvailabilityStatus @default(FLEXIBLE)
  availableFrom      DateTime?
  locationId         String?
  lat                Float? // private: never returned to other users at full precision
  lng                Float?
  maxTravelKm        Int?
  willingToRelocate  Boolean            @default(false)
  languages          String[]
  // Extra CV details. `languageLevels` maps a language name to BASIC, GOOD or FLUENT. Address and nationality are for the CV only and are never shown to employers.
  languageLevels     Json               @default("{}")
  objective          String?
  website            String?
  addressLine        String?
  nationality        String?
  portfolioUrls      String[]
  photoFileId        String?
  cvFileId           String?
  completionPct      Int                @default(0)
  isVisible          Boolean            @default(true)
  profileViews       Int                @default(0)
  embedding          Float[]
  embeddingModel     String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category?         @relation(fields: [categoryId], references: [id])
  location        Location?         @relation(fields: [locationId], references: [id])
  skills          WorkerSkill[]
  criteria        WorkerCriterion[]
  invitations     JobInvitation[]
  serviceListings ServiceListing[]
  education       Education[]
  certifications  Certification[]
  experiences     WorkExperience[]
  applications    Application[]
  savedJobs       SavedJob[]
  recommendations Recommendation[]
  activities      ProfileActivity[]
  views           ProfileView[]
  identity        WorkerIdentity?
  cvChecks        CvCheck[]

  @@index([categoryId])
  @@index([locationId])
  @@index([isVisible, availability])
}

model WorkerSkill {
  workerId    String
  skillId     String
  proficiency Int            @default(3) // 1..5, enforced by CHECK in migration
  years       Int?
  source      EvidenceSource @default(SELF_REPORTED)
  // Set when the worker passed the skill test. A different thing from VERIFIED (an administrator checked a document): it
  // shows what they could answer on the day, and it is not used in the match score or the trust level.
  testedScore Int?
  testedAt    DateTime?
  worker      WorkerProfile  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  skill       Skill          @relation(fields: [skillId], references: [id])

  @@id([workerId, skillId])
  @@index([skillId])
}

model Education {
  id             String         @id @default(uuid())
  workerId       String
  level          EducationLevel
  field          String?
  institution    String?
  department     String?
  gpa            Float? // optional: informal and vocational routes have none
  gpaScale       Float? // the scale the GPA is on (4, 5, 100 ...)
  year           Int?
  source         EvidenceSource @default(SELF_REPORTED)
  evidenceFileId String?
  worker         WorkerProfile  @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
}

model Certification {
  id             String         @id @default(uuid())
  workerId       String
  name           String
  issuer         String?
  year           Int?
  source         EvidenceSource @default(SELF_REPORTED)
  evidenceFileId String?
  worker         WorkerProfile  @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
}

model WorkExperience {
  id             String         @id @default(uuid())
  workerId       String
  title          String
  employer       String?
  categoryId     String?
  startDate      DateTime
  endDate        DateTime?
  description    String?
  location       String?
  employmentType EmploymentType?
  reasonLeft     String?
  achievements   String?
  // SELF_REPORTED until an administrator approves an experience letter for this job; only that sets VERIFIED.
  source         EvidenceSource @default(SELF_REPORTED)
  evidenceFileId String?
  worker         WorkerProfile  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  category       Category?      @relation(fields: [categoryId], references: [id])

  @@index([workerId])
}

// ───────────────────────── Employer side ─────────────────────────

model Organization {
  id                 String             @id @default(uuid())
  reviews            EmployerReview[]
  offers             JobOffer[]
  profileViews       ProfileView[]
  name               String
  type               OrganizationType
  description        String?
  website            String?
  address            String?
  locationId         String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  location      Location?            @relation(fields: [locationId], references: [id])
  employers     EmployerProfile[]
  jobs          Job[]
  subscriptions Subscription[]
  planRequests  PlanUpgradeRequest[]
  legal         OrganizationLegal?

  @@index([verificationStatus])
}

model EmployerProfile {
  id             String       @id @default(uuid())
  userId         String       @unique
  organizationId String
  roleInOrg      String?
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

// ───────────────────────── Jobs ─────────────────────────

model Job {
  id                     String             @id @default(uuid())
  organizationId         String
  postedById             String
  title                  String
  description            String
  categoryId             String
  employmentType         EmploymentType
  workMode               WorkMode           @default(ON_SITE)
  seniority              JobSeniority?
  // Groups the employer says they welcome (disability, students, refugees ...). A welcome, never a restriction.
  openTo                 String[]           @default([])
  workplace              Workplace?
  recruitmentMethod      RecruitmentMethod?
  payBasis               PayBasis? // what salaryMin and salaryMax count: per month, per day, per hour ...
  benefitTags            String[]           @default([]) // accommodation, transport, food, health insurance ...
  salaryMin              Int?
  salaryMax              Int?
  currency               String             @default("ETB")
  vacancies              Int                @default(1)
  deadline               DateTime?
  startDate              DateTime?
  schedule               String?
  benefits               String?
  minExperienceYears     Int? // null = no minimum: inexperience is not penalized
  requiredEducationLevel EducationLevel? // null = no formal qualification required
  languages              String[]
  locationId             String?
  lat                    Float?
  lng                    Float?
  status                 JobStatus          @default(DRAFT)
  descriptionHash        String
  // Vacancy reference number, as on a formal announcement. Required by the hiring rules of some organization types.
  referenceNumber        String?            @db.VarChar(40)
  embedding              Float[]
  embeddingModel         String?
  extractionApprovedAt   DateTime?
  publishedAt            DateTime?
  featuredAt             DateTime? // set while the employer has chosen to feature this job
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id])
  postedBy        User             @relation(fields: [postedById], references: [id])
  category        Category         @relation(fields: [categoryId], references: [id])
  location        Location?        @relation(fields: [locationId], references: [id])
  skills          JobSkill[]
  criteria        JobCriterion[]
  invitations     JobInvitation[]
  applications    Application[]
  savedBy         SavedJob[]
  recommendations Recommendation[]

  @@index([status, categoryId, locationId, deadline])
  @@index([organizationId])
  @@index([descriptionHash])
  @@index([organizationId, referenceNumber])
}

model JobSkill {
  jobId          String
  skillId        String
  importance     SkillImportance @default(REQUIRED)
  minProficiency Int?
  job            Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill          Skill           @relation(fields: [skillId], references: [id])

  @@id([jobId, skillId])
  @@index([skillId])
}

// ───────────────────────── Recruitment workflow ─────────────────────────

model Application {
  id            String            @id @default(uuid())
  jobId         String
  workerId      String
  status        ApplicationStatus @default(PENDING)
  coverNote     String?
  matchSnapshot Json? // score + explanation at time of applying
  autoApplied   Boolean           @default(false) // created by the worker's opt-in auto-apply
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  job          Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker       WorkerProfile              @relation(fields: [workerId], references: [id], onDelete: Cascade)
  history      ApplicationStatusHistory[]
  interviews   Interview[]
  conversation Conversation?
  review       EmployerReview?
  offer        JobOffer?
  steps        HiringStep[]
  appeal       ApplicationAppeal?

  @@unique([jobId, workerId])
  @@index([workerId, status])
  @@index([jobId, status])
}

model ApplicationStatusHistory {
  id            String             @id @default(uuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  byUserId      String?
  note          String?
  createdAt     DateTime           @default(now())
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model Interview {
  id             String            @id @default(uuid())
  applicationId  String
  scheduledAt    DateTime
  mode           InterviewMode
  locationOrLink String?
  status         InterviewStatus   @default(SCHEDULED)
  remindedDayAt  DateTime? // reminder about a day ahead was sent
  remindedHourAt DateTime? // reminder about an hour ahead was sent
  videoRoom      String? // set when the platform made the meeting room (so a move can keep the same link)
  workerResponse InterviewResponse @default(PENDING) // the candidate's answer to this time; back to PENDING when the time is moved
  respondedAt    DateTime?
  declineNote    String? // optional reason the candidate gave, shown to the employer
  application    Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([status, scheduledAt])
}

model SavedJob {
  workerId  String
  jobId     String
  createdAt DateTime      @default(now())
  worker    WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  job       Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([workerId, jobId])
}

model Review {
  id        String   @id @default(uuid())
  authorId  String
  subjectId String
  rating    Int // 1..5, enforced by CHECK in migration
  comment   String?
  createdAt DateTime @default(now())
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  subject   User     @relation("ReviewSubject", fields: [subjectId], references: [id])

  @@index([subjectId])
}

// A worker's rating of an employer after they were interviewed or hired. One per application, anonymous to the
// employer (only totals are shown, and only once there are enough of them), and structured so there is no free text to moderate.
enum OfferStatus {
  OFFERED
  ACCEPTED
  DECLINED
  WITHDRAWN // the employer took it back, before or after it was accepted
  EXPIRED // nobody answered by the respond-by date
  STARTED
}

// The terms an employer puts in writing for someone they decided to hire (application ACCEPTED). The decision to hire stays
// in the application workflow, with its hiring rules; the offer only records the start date, pay and the worker's answer.
enum HiringStepKind {
  WRITTEN_EXAM
  PRACTICAL_TEST
  SCORE_SHEET
  REFERENCE_CHECKED
  GUARANTOR_RECORDED
}

// What the employer did to select this candidate, recorded before the decision. ID_VERIFIED is not stored: it is read from the
// candidate's approved ID document. `data` depends on the kind (see modules/hiring/steps.ts).
model HiringStep {
  id            String         @id @default(uuid())
  applicationId String
  kind          HiringStepKind
  data          Json
  recordedById  String
  createdAt     DateTime       @default(now())
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, kind])
}

enum AppealOutcome {
  UPHELD // the decision stands
  REOPENED // the application goes back under review
}

// A rejected candidate asking the employer to look again, where the organization type allows it. One per application.
model ApplicationAppeal {
  id            String         @id @default(uuid())
  applicationId String         @unique
  reason        String
  createdAt     DateTime       @default(now())
  answeredAt    DateTime?
  outcome       AppealOutcome?
  reply         String?
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model JobOffer {
  id               String        @id @default(uuid())
  probationDays    Int? // stated probation period, within the organization type's limit
  applicationId    String        @unique
  organizationId   String
  workerId         String
  status           OfferStatus   @default(OFFERED)
  salary           Int? // per month, in `currency`; null = as advertised
  currency         String        @default("ETB")
  startDate        DateTime      @db.Date
  respondBy        DateTime      @db.Date
  note             String? // written by the employer, shown only to the worker
  respondedAt      DateTime?
  startedAt        DateTime?
  expiryRemindedAt DateTime?
  startRemindedAt  DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  application      Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  worker           WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, status])
  @@index([organizationId, status])
  @@index([status, startDate])
}

model EmployerReview {
  id             String        @id @default(uuid())
  applicationId  String        @unique
  organizationId String
  workerId       String
  application    Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  rating         Int // 1..5, enforced by CHECK in migration
  paidOnTime     Boolean? // null = not applicable or not known yet
  respectful     Boolean?
  asDescribed    Boolean? // the job was as the advertisement said
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  worker         WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ───────────────────────── Matching ─────────────────────────

model MatchWeights {
  id         String    @id @default(uuid())
  categoryId String? // null = global default
  weights    Json // {skills, experience, location, qualification, availability, preferences, criteria}
  version    Int
  active     Boolean   @default(true)
  createdBy  String?
  createdAt  DateTime  @default(now())
  category   Category? @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, version])
  @@index([active])
}

model Recommendation {
  id             String                   @id @default(uuid())
  jobId          String
  workerId       String
  direction      RecommendationDirection
  score          Float
  confidence     Float
  components     Json
  explanation    String
  engineVersion  String
  weightsVersion Int?
  createdAt      DateTime                 @default(now())
  job            Job                      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker         WorkerProfile            @relation(fields: [workerId], references: [id], onDelete: Cascade)
  feedback       RecommendationFeedback[]

  @@index([jobId, score(sort: Desc)])
  @@index([workerId, score(sort: Desc)])
}

model RecommendationFeedback {
  id               String         @id @default(uuid())
  recommendationId String
  action           FeedbackAction
  createdAt        DateTime       @default(now())
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@index([recommendationId])
}

// ───────────────────────── Communication ─────────────────────────

model Conversation {
  id               String                    @id @default(uuid())
  // One conversation per application (NULLs are allowed many times, a given application only once).
  // The conversation is deleted together with its application.
  applicationId    String?                   @unique
  // A conversation the worker started from an invitation, before applying. Stays attached once they apply.
  invitationId     String?                   @unique
  invitation       JobInvitation?            @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  // A conversation the provider opened by accepting a service inquiry.
  serviceInquiryId String?                   @unique
  serviceInquiry   ServiceInquiry?           @relation(fields: [serviceInquiryId], references: [id], onDelete: Cascade)
  application      Application?              @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdAt        DateTime                  @default(now())
  participants     ConversationParticipant[]
  messages         Message[]
}

model ConversationParticipant {
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // Deleting an account removes the messages it sent (right to erasure); the other side loses those lines.
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// ───────────────────────── Trust and safety ─────────────────────────

// Does a worker's CV agree with the details they typed on their profile? ACCEPTED: nothing contradicts. DECLINED: a clear
// contradiction (for example the CV is in someone else's name). UNCHECKED: the CV could not be read well enough to say.
enum ProfileCheckOutcome {
  ACCEPTED
  DECLINED
  UNCHECKED
}

// One comparison of a worker's CV with their profile. The text of the CV is not stored, only what was found and what differed.
model CvCheck {
  id            String              @id @default(uuid())
  workerId      String
  fileId        String? // the CV file that was compared
  outcome       ProfileCheckOutcome
  findings      Json // [{ code, severity: ok | info | warn | block, message, expected?, found? }]
  profileHash   String // changes when the profile details that matter change, so the check is repeated
  ocrConfidence Int?
  createdAt     DateTime            @default(now())
  worker        WorkerProfile       @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, createdAt])
}

enum DocumentType {
  BIRTH_CERTIFICATE
  EDUCATION_CERTIFICATE
  NATIONAL_ID // a worker's kebele ID, national (Fayda) ID, passport or driving licence
  EXPERIENCE_LETTER
  PROFESSIONAL_CERTIFICATE // a trade, competence (COC), training or professional certificate for one certification entry
  BUSINESS_LICENSE
  TIN_CERTIFICATE
  COMMERCIAL_REGISTRATION
  REPRESENTATIVE_ID // the ID of the person who manages the employer account
  AUTHORIZATION_LETTER
  ORG_REGISTRATION // NGO, cooperative, public enterprise or training-institution registration or accreditation
  GOVERNMENT_LETTER
  AGENCY_LICENSE
}

// How well what we could read from an uploaded document agrees with what the person typed. It says nothing about
// whether the document is genuine: an administrator decides that. CONSISTENT: every required detail was found.
// PARTIAL: the name matched but a supporting detail (institution, year, level) was not found. MISMATCH: a required
// detail was not found in readable text. UNREADABLE: too little text could be read to say anything.
enum DocumentCheckOutcome {
  CONSISTENT
  PARTIAL
  MISMATCH
  UNREADABLE
}

// Private details used to check documents. Never shown to employers or in search results.
model WorkerIdentity {
  workerId        String        @id
  fatherName      String?
  grandfatherName String?
  idType          String? // KEBELE_ID | NATIONAL_ID | PASSPORT | DRIVING_LICENCE
  idNumber        String?
  dateOfBirth     DateTime?     @db.Date
  verifiedAt      DateTime? // an administrator approved a birth certificate that matched these details
  updatedAt       DateTime      @updatedAt
  worker          WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
}

// The result of the automatic comparison for one uploaded document. The text read from the file is NOT stored, only
// which details were found, so no copy of a certificate's contents is kept beyond the file itself.
model DocumentCheck {
  id              String               @id @default(uuid())
  userId          String
  fileId          String               @unique
  docType         DocumentType
  educationId     String? // the education entry an education certificate was uploaded for
  experienceId    String? // the work entry an experience letter was uploaded for
  certificationId String? // the certification entry a professional certificate was uploaded for
  organizationId  String? // the organization an employer document was uploaded for
  outcome         DocumentCheckOutcome
  ocrConfidence   Int?
  textChars       Int                  @default(0)
  fields          Json // [{ field, expected, status: FOUND | NOT_FOUND, required }]
  flags           Json // [{ code, level: info | warn, message }]
  createdAt       DateTime             @default(now())
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  file            FileAsset            @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Legal details an employer types, so the uploaded business documents can be compared with them. Private to the
// organization and administrators; never shown to workers.
model OrganizationLegal {
  organizationId     String       @id
  tin                String? // tax identification number
  licenseNumber      String?
  licenseExpiresAt   DateTime?    @db.Date
  registrationNumber String?
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model VerificationRequest {
  id             String           @id @default(uuid())
  userId         String
  kind           VerificationKind
  // What is being verified: EDUCATION or CERTIFICATION (a row id) or SKILL (a skill id); null for employer/phone/email.
  targetType     String?
  targetId       String?
  evidenceFileId String?
  status         RequestStatus    @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  note           String?
  createdAt      DateTime         @default(now())
  user           User             @relation("VerificationRequester", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy     User?            @relation("VerificationReviewer", fields: [reviewedById], references: [id])

  @@index([status, kind])
  @@index([userId])
}

model Report {
  id             String           @id @default(uuid())
  reporterId     String
  targetType     ReportTargetType
  targetId       String
  reason         String
  details        String?
  status         ReportStatus     @default(OPEN)
  resolutionNote String?
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())
  reporter       User             @relation("ReportReporter", fields: [reporterId], references: [id])
  resolvedBy     User?            @relation("ReportResolver", fields: [resolvedById], references: [id])

  @@index([status])
  @@index([targetType, targetId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model FileAsset {
  id            String         @id @default(uuid())
  ownerId       String
  kind          FileKind
  storagePath   String
  mime          String
  sizeBytes     Int
  sha256        String
  createdAt     DateTime       @default(now())
  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  documentCheck DocumentCheck?

  @@index([ownerId, kind])
  @@index([sha256])
}

model Translation {
  key       String
  locale    Locale
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@id([key, locale])
}

// ───────── Sector criteria (Phase 15) ─────────
// Sector-specific requirements (licence class, professional registration, shifts, tools...) defined by administrators
// per category (categoryId null = applies to every sector). A job asks for a criterion; a worker states it.

enum CriterionType {
  BOOLEAN
  NUMBER
  CHOICE
  MULTI_CHOICE
}

enum CriterionImportance {
  MUST_HAVE
  PREFERRED
}

model CriterionDefinition {
  id                String            @id @default(uuid())
  categoryId        String?
  key               String // stable machine name, e.g. "licence_class"
  labelEn           String
  labelAm           String?
  labelOm           String?
  helpEn            String?
  type              CriterionType
  options           Json? // [{ value, labelEn, labelAm?, labelOm? }] for CHOICE / MULTI_CHOICE
  unit              String? // e.g. "years", "kg"
  minValue          Int? // allowed range for NUMBER
  maxValue          Int?
  mustHaveAllowed   Boolean           @default(true)
  evidenceSuggested Boolean           @default(false) // a document can verify it (licence, registration)
  sortOrder         Int               @default(0)
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  category          Category?         @relation(fields: [categoryId], references: [id])
  jobCriteria       JobCriterion[]
  workerCriteria    WorkerCriterion[]

  @@unique([categoryId, key])
  @@index([categoryId, isActive])
}

model JobCriterion {
  jobId       String
  criterionId String
  importance  CriterionImportance @default(PREFERRED)
  // BOOLEAN {equals:true}  NUMBER {min:n}  CHOICE {oneOf:[..]}  MULTI_CHOICE {allOf:[..]}
  value       Json
  job         Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  criterion   CriterionDefinition @relation(fields: [criterionId], references: [id])

  @@id([jobId, criterionId])
  @@index([criterionId])
}

model WorkerCriterion {
  id          String              @id @default(uuid())
  workerId    String
  criterionId String
  // BOOLEAN true/false  NUMBER n  CHOICE "value"  MULTI_CHOICE ["a","b"]
  value       Json
  source      EvidenceSource      @default(SELF_REPORTED)
  verifiedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  worker      WorkerProfile       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  criterion   CriterionDefinition @relation(fields: [criterionId], references: [id])

  @@unique([workerId, criterionId])
  @@index([criterionId])
}

// ───────── Invitations to apply (Phase 16) ─────────
// An employer invites a recommended worker to apply for one of their live jobs. The worker decides: nothing is shared
// with the employer (no contact details) until the worker applies, and an invitation is not an application.

enum InvitationStatus {
  SENT
  APPLIED
  DECLINED
}

model JobInvitation {
  id           String           @id @default(uuid())
  jobId        String
  workerId     String
  invitedById  String
  message      String?
  status       InvitationStatus @default(SENT)
  createdAt    DateTime         @default(now())
  respondedAt  DateTime?
  job          Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker       WorkerProfile    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  invitedBy    User             @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)
  conversation Conversation?

  @@unique([jobId, workerId])
  @@index([workerId, status])
  @@index([invitedById, createdAt])
}

// ───────── Hiring rules by organization type (Phase 17) ─────────
// How an organization may announce vacancies and decide on candidates depends on what kind of organization it is
// (a government office follows formal recruitment rules, a private company decides freely). One row per type,
// edited by administrators. The seeded values are reasoned starting defaults, NOT legal advice.

model HiringPolicy {
  organizationType    OrganizationType @id
  label               String? // shown on job pages, e.g. "Government vacancy"
  minAnnouncementDays Int              @default(0) // a job must stay open at least this long, and no one can be hired before it closes
  requireVerified     Boolean          @default(false) // the organization must be verified before it can publish
  requireDeadline     Boolean          @default(false)
  requireSalary       Boolean          @default(false) // salary or pay-scale range stated
  requireReference    Boolean          @default(false) // vacancy reference number
  requireDecisionNote Boolean          @default(false) // a written reason when accepting or rejecting
  requireInterview    Boolean          @default(false) // an interview must be recorded before hiring
  // The recruitment METHODS of this kind of organization. Required steps must be recorded before a candidate can be accepted;
  // suggested steps are only shown as good practice. Values: ID_VERIFIED, WRITTEN_EXAM, SCORE_SHEET, REFERENCE_CHECKED, GUARANTOR_RECORDED.
  requiredSteps       String[]         @default([])
  suggestedSteps      String[]         @default([])
  panelSize           Int              @default(1) // distinct selection-panel members who must have recorded a score sheet (when SCORE_SHEET is required)
  maxProbationDays    Int? // longest probation an offer may state; null = no limit set
  appealDays          Int              @default(0) // days after a rejection in which the candidate may ask for a review; 0 = no appeal
  updatedAt           DateTime         @updatedAt
  updatedById         String?
}

// ───────────────────────── Internships, volunteering, training, apprenticeships, references ─────────────────────────
enum ActivityKind {
  INTERNSHIP
  VOLUNTEER
  TRAINING
  APPRENTICESHIP // learning a trade from a master, common outside formal schooling
  REFERENCE // a person who can vouch for the worker's skills (no contact details are stored or shown)
  AWARD // a prize, recognition or achievement; `title` is the award and `organization` who gave it
}

model ProfileActivity {
  id             String         @id @default(uuid())
  workerId       String
  kind           ActivityKind
  title          String // what: role, course, trade, or the referee's name for REFERENCE
  organization   String? // where: company, NGO, training centre, workshop; for REFERENCE their relationship
  startDate      DateTime?
  endDate        DateTime?
  hours          Int?
  description    String?
  source         EvidenceSource @default(SELF_REPORTED)
  evidenceFileId String?
  worker         WorkerProfile  @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, kind])
}

// Photos of finished work (a built cabinet, a sewn dress, a repaired engine), shown on the worker's profile to employers.
// Self-reported: nobody checks that the work is theirs. The image is re-encoded on upload, which strips hidden metadata such as GPS.
// A short multiple-choice test for one skill. `questions` is the whole pool: [{ id, text, options[], answer }]. The server
// asks a random `questionsAsked` of them and grades; the answers are never sent to a browser.
model SkillTest {
  id             String             @id @default(uuid())
  skillId        String             @unique
  title          String
  description    String?
  passPercent    Int                @default(70)
  questionsAsked Int                @default(8)
  isActive       Boolean            @default(true)
  questions      Json
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  skill          Skill              @relation(fields: [skillId], references: [id], onDelete: Cascade)
  attempts       SkillTestAttempt[]
}

model SkillTestAttempt {
  id         String        @id @default(uuid())
  testId     String
  workerId   String
  picked     Json // the ids of the questions asked, in order
  startedAt  DateTime      @default(now())
  finishedAt DateTime?
  correct    Int?
  total      Int?
  passed     Boolean?
  test       SkillTest     @relation(fields: [testId], references: [id], onDelete: Cascade)
  worker     WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, testId, startedAt])
}

model PortfolioItem {
  id        String        @id @default(uuid())
  workerId  String
  fileId    String        @unique
  caption   String?
  skillId   String?
  createdAt DateTime      @default(now())
  worker    WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  skill     Skill?        @relation(fields: [skillId], references: [id], onDelete: SetNull)

  @@index([workerId, createdAt])
}

// ───────────────────────── Subscriptions (plans and limits, managed by administrators) ─────────────────────────
// No payment processing: an administrator records how the employer paid. null limit = unlimited.
enum SubscriptionStatus {
  ACTIVE
  CANCELLED
}

enum PlanRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

// An employer's request to move to another plan. The platform takes no payment: an administrator reads the request,
// agrees the payment outside the system, then approves (which assigns the plan) or declines it.
model PlanUpgradeRequest {
  id             String            @id @default(uuid())
  organizationId String
  planId         String
  requestedById  String
  note           String? // what the employer wants the administrator to know (for example how they will pay)
  status         PlanRequestStatus @default(PENDING)
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime          @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([organizationId, status])
  @@index([status, createdAt])
}

model SubscriptionPlan {
  id                              String   @id @default(uuid())
  slug                            String   @unique
  name                            String
  description                     String?
  priceEtbMonthly                 Int      @default(0) // shown to employers; informational, nothing is charged by the system
  maxActiveJobs                   Int? // live or pending-review jobs at one time
  maxInvitationsPerMonth          Int? // "invite to apply" messages per calendar month
  maxFeaturedJobs                 Int? // live jobs shown first in the job search with a "Featured" label at one time
  maxApplicationsReviewedPerMonth Int? // applications an employer may move out of "pending" per calendar month
  canSearchWorkers                Boolean  @default(true)
  isActive                        Boolean  @default(true) // inactive plans cannot be newly assigned
  isDefault                       Boolean  @default(false) // what an organization without a subscription gets (exactly one)
  sortOrder                       Int      @default(0)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  subscriptions   Subscription[]
  upgradeRequests PlanUpgradeRequest[]
}

model Subscription {
  id             String             @id @default(uuid())
  organizationId String
  planId         String
  status         SubscriptionStatus @default(ACTIVE)
  startsAt       DateTime           @default(now())
  endsAt         DateTime? // null = until cancelled
  paymentNote    String? // for example "paid by bank transfer, ref 1234"; recorded by the administrator
  assignedById   String?
  cancelledAt    DateTime?
  createdAt      DateTime           @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([organizationId, status])
  @@index([planId])
}

// A worker's saved job search. The filters are the same keys the jobs page puts in its URL.
model SavedSearch {
  id            String    @id @default(uuid())
  userId        String
  name          String
  filters       Json
  alertsEnabled Boolean   @default(true)
  lastAlertedAt DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([alertsEnabled])
}

// Which organisation looked at which worker's profile (one row per pair; never the individual employer).
model ProfileView {
  workerId       String
  organizationId String
  firstViewedAt  DateTime
  lastViewedAt   DateTime
  viewCount      Int           @default(1)
  worker         WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([workerId, organizationId])
  @@index([workerId, lastViewedAt])
}

// A learning option an administrator has listed (a short course, a TVET programme, an online class...).
model TrainingCourse {
  id           String   @id @default(uuid())
  title        String
  provider     String
  description  String?
  url          String?
  online       Boolean  @default(false)
  locationId   String?
  costEtb      Int? // null = not stated, 0 = free
  durationText String?
  languages    String[]
  isActive     Boolean  @default(true)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  location Location?             @relation(fields: [locationId], references: [id], onDelete: SetNull)
  skills   TrainingCourseSkill[]

  @@index([isActive])
}

model TrainingCourseSkill {
  courseId String
  skillId  String
  course   TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skill    Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([courseId, skillId])
  @@index([skillId])
}

// ───────── Service marketplace ─────────
// Independent workers advertise what they offer, and a customer asks them directly. No vacancy and no employer are needed.
// Contact is consent-based like the rest of the platform: a customer sends an inquiry, and a chat opens only if the
// provider accepts. Money is never handled here: the two people agree on payment between themselves.

enum ServiceStatus {
  DRAFT
  ACTIVE
  PAUSED
  REMOVED
}

// Where the service is carried out.
enum ServiceMode {
  AT_CUSTOMER // the provider comes to the customer
  AT_PROVIDER // the customer goes to the provider's shop or workshop
  REMOTE
}

enum ServiceInquiryStatus {
  SENT
  ACCEPTED
  DECLINED
  CANCELLED
}

model ServiceListing {
  id              String        @id @default(uuid())
  workerId        String
  title           String
  description     String
  categoryId      String
  serviceMode     ServiceMode   @default(AT_CUSTOMER)
  payBasis        PayBasis? // what priceMin and priceMax count; null = not stated
  priceMin        Int?
  priceMax        Int?
  currency        String        @default("ETB")
  toolsIncluded   Boolean       @default(false)
  availability    String? // free text, for example "Mon to Sat, 8:00 to 17:00"
  locationId      String? // the area served, never an exact address
  status          ServiceStatus @default(DRAFT)
  descriptionHash String
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  worker    WorkerProfile    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  category  Category         @relation(fields: [categoryId], references: [id])
  location  Location?        @relation(fields: [locationId], references: [id])
  skills    ServiceSkill[]
  inquiries ServiceInquiry[]

  @@index([status, categoryId, locationId])
  @@index([workerId, status])
  @@index([descriptionHash])
}

model ServiceSkill {
  serviceId String
  skillId   String
  service   ServiceListing @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  skill     Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([serviceId, skillId])
  @@index([skillId])
}

model ServiceInquiry {
  id            String               @id @default(uuid())
  serviceId     String
  customerId    String
  message       String
  preferredDate DateTime?
  status        ServiceInquiryStatus @default(SENT)
  createdAt     DateTime             @default(now())
  respondedAt   DateTime?
  service       ServiceListing       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customer      User                 @relation("InquiryCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  conversation  Conversation?

  @@index([serviceId, status])
  @@index([customerId, createdAt])
}

// A provider no longer accepts inquiries from one customer.
model ServiceBlock {
  providerUserId String
  customerId     String
  createdAt      DateTime @default(now())
  provider       User     @relation("BlockProvider", fields: [providerUserId], references: [id], onDelete: Cascade)
  customer       User     @relation("BlockCustomer", fields: [customerId], references: [id], onDelete: Cascade)

  @@id([providerUserId, customerId])
}

// ───────────────────────── Administration: settings and announcements ─────────────────────────

// Switches an administrator can change without a deployment (maintenance mode, registration, daily application limit).
// Only known keys are accepted by the API; see modules/admin/settings.ts.
model PlatformSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?
}

enum AnnouncementAudience {
  ALL
  WORKERS
  EMPLOYERS
}

// A notice from the administrators, shown as a banner while it is active and optionally sent to each person's notifications.
// `regionId` is a Location of level REGION; empty means everywhere. A withdrawn announcement stops showing at once.
model Announcement {
  id            String               @id @default(uuid())
  title         String
  body          String
  audience      AnnouncementAudience @default(ALL)
  regionId      String?
  startsAt      DateTime             @default(now())
  endsAt        DateTime?
  withdrawnAt   DateTime?
  notifiedCount Int                  @default(0)
  createdById   String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([startsAt, endsAt])
}
