{
  "name": "ethiotalent-ai",
  "version": "0.1.0",
  "private": true,
  "description": "EthioTalent AI - Connecting Ethiopian Talent with the Right Opportunities.",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:up": "docker compose -f infra/docker-compose.yml up -d db",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:logs": "docker compose -f infra/docker-compose.yml logs -f db",
    "dev:api": "npm run dev --workspace @ethiotalent/api",
    "dev:web": "npm run dev --workspace @ethiotalent/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.74.0"
  }
}
