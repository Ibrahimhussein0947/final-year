{
  "name": "ethiotalent-ai",
  "version": "0.1.0",
  "private": true,
  "description": "EthioTalent AI - Connecting Ethiopian Talent with the Right Opportunities.",
  "workspaces": ["apps/web", "apps/api", "packages/*"],
  "engines": { "node": ">=20" },
