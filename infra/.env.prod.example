# Copy to infra/.env.prod and fill in. Never commit the real file (it is git-ignored).
# Generate secrets with:  openssl rand -hex 32      (use letters and digits only for the database password)

POSTGRES_USER=ethiotalent
POSTGRES_PASSWORD=
POSTGRES_DB=ethiotalent

JWT_ACCESS_SECRET=

# The public address users type in the browser (also the allowed CORS origin). No trailing slash.
PUBLIC_URL=https://jobs.example.com
# Host port for the web container. Put a TLS-terminating proxy in front of it.
WEB_PORT=8080
# "true" requires HTTPS (browsers drop Secure cookies on plain http, except on localhost).
# Set to false ONLY for a trial run over plain HTTP; sessions are then exposed on the network.
COOKIE_SECURE=true

REVIEW_UNVERIFIED_JOBS=false

# Optional. Leave empty to run without semantic matching / SMS (the app says so on screen).
AI_SERVICE_URL=
AI_SERVICE_TOKEN=
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
